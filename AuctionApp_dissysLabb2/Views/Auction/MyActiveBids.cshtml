@model IEnumerable<AuctionApp_dissysLabb2.Models.AuctionsWithMyActiveBidsViewModel>

@{
    ViewData["Title"] = "MyActiveBids";
}

<h1>Your Active Bids</h1>

@if (!Model.Any())
{
    <div class="text-center mt-5">
        <h3>No bids made yet.</h3>
    </div>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SellerName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartingPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HighestBidAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UsersHighestBidAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HighestBidderName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsOver)
            </th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SellerName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.StartingPrice)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HighestBidAmount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UsersHighestBidAmount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HighestBidderName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.StartTime)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EndTime)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsOver)
                </td>
                <td>
                    @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                    @if (!(User.Identity.Name.Equals(item.SellerName)) && User.Identity.Name != null)
                    {
                        @Html.ActionLink("Bid on auction", "Create", "Bid", new { auctionId = item.Id })
                    }

                </td>
            </tr>
        }
        </tbody>
    </table>
}
