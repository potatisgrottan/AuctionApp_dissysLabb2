@model IEnumerable<AuctionApp_dissysLabb2.Models.BidViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>My Bids</h1>
@if (!Model.Any())
{
    <div class="text-center mt-5">
        <h3>No bids made yet.</h3>
    </div>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.BidderName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Amount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TimePlaced)
            </th>
            <th></th>
        </tr>
        </thead>
        <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.BidderName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Amount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TimePlaced)
                </td>
                <td>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
